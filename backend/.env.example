# Required
OPENAI_API_KEY=sk-...

# Frontend origins allowed to call the API (comma-separated, no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000
# Optional: regex for extra origins, e.g. Vercel preview deployments
# ALLOWED_ORIGIN_REGEX=https://fastapply-.*\.vercel\.app

# Optional tuning (defaults shown)
# LLM_MODEL=gpt-4.1-mini
# RESEARCH_MODEL=gpt-4.1-mini
# EMBEDDING_MODEL=text-embedding-3-small
# MAX_UPLOAD_MB=5
# MAX_JOB_DESCRIPTION_CHARS=20000
# RATE_LIMIT_REQUESTS=10
# RATE_LIMIT_WINDOW_SECONDS=3600
# LOG_LEVEL=INFO
